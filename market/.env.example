# 이 파일은 "어떤 키가 필요한지" 보여주는 예시입니다. 진짜 키는 .env 에만 적고, .env 는 GitHub에 올라가지 않습니다.
# 키가 채팅·캡처·커밋에 한 번이라도 노출되면 그 키는 버리고 새로 발급합니다.

# 관리자 비밀번호 (배포 전 반드시 변경)
ADMIN_PASSWORD=

# Google Gemini (글쓰기·사진 읽기)
GEMINI_API_KEY=

# 공공데이터포털 (data.go.kr) 일반 인증키. 여러 API가 같은 키를 씁니다.
DATA_GO_KR_KEY=

# 관광 API (한국관광공사 TourAPI 등). 공공데이터포털 키와 같을 수 있습니다.
TOUR_API_KEY=

# 네이버 지도 (NCP Maps). 클라이언트 ID는 브라우저에 노출되는 값이라 콘솔에서 '허용 도메인'을 꼭 제한합니다.
NAVER_MAP_CLIENT_ID=
